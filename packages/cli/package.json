{
  "name": "create-fs-starter",
  "version": "0.1.0",
  "description": "Scaffolder for new fullstack projects (the CLI that produces apps from this Starter).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "create-fs-starter": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
